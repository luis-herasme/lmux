{
  "name": "lmux",
  "version": "0.1.0",
  "description": "lmux: a minimal terminal emulator built with Electron and xterm.js, as a learning project",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc && vite build",
    "start": "npm run build && electron .",
    "check": "tsc --noEmit",
    "test": "npm run build && electron dist/test/index.js",
    "rebuild": "electron-rebuild -f -w node-pty",
    "package": "npm run build && electron-builder --mac --dir",
    "dist": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dockview": "^7.0.4",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.11.1",
    "markdown-it": "^15.0.0",
    "mermaid": "^11.16.1",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^26.1.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "type-fest": "^5.8.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "build": {
    "directories": {
      "output": "release"
    },
    "appId": "dev.herasme.lmux",
    "productName": "lmux",
    "files": [
      "dist/**/*",
      "!dist/test",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    }
  }
}
